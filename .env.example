# Surge — Personal Automation Hub
# Copie para .env e preencha

# --- Scanner (portfolio-aware) ---
# Nenhum ticker aqui: gerencie via `surge portfolio add TICKER --qty N`
# (validado via Brapi free). Radar varre o mercado via /api/quote/list.
# Queda mínima (%) vs fechamento anterior para gerar oportunidade. Default 5.0
SURGE_DROP_THRESHOLD=5.0
# Intervalo do scheduler (cron). Default: todo dia útil às 18h (America/Sao_Paulo)
SURGE_CRON_HOUR=18
SURGE_CRON_MINUTE=0

# --- Storage ---
SURGE_DB_PATH=./surge.db

# --- Email (SMTP) ---
SURGE_EMAIL_ENABLED=false
SURGE_SMTP_HOST=smtp.gmail.com
SURGE_SMTP_PORT=587
SURGE_SMTP_USER=
SURGE_SMTP_PASSWORD=
SURGE_EMAIL_FROM=
SURGE_EMAIL_TO=

# --- Leitura de comandos por Gmail/IMAP (senha de app) ---
SURGE_IMAP_ENABLED=false
SURGE_IMAP_HOST=imap.gmail.com
SURGE_IMAP_PORT=993
SURGE_IMAP_USER=
SURGE_IMAP_PASSWORD=
SURGE_IMAP_MAILBOX=INBOX
SURGE_INVESTMENT_EMAIL_SUBJECT=SURGE: INVESTIMENTO
SURGE_EMAIL_POLL_MINUTES=5

# --- Telegram ---
SURGE_TELEGRAM_ENABLED=false
SURGE_TELEGRAM_BOT_TOKEN=
SURGE_TELEGRAM_CHAT_ID=

# --- BRAPI (opcional, fallback para B3) ---
SURGE_BRAPI_TOKEN=
SURGE_BRAPI_BASE_URL=https://brapi.dev


# --- Gemini ---
SURGE_GEMINI_API_KEY=
SURGE_MAX_OPPORTUNITIES_PER_SCAN=10

# --- App ---
SURGE_TIMEZONE=America/Sao_Paulo
SURGE_LOG_LEVEL=INFO
